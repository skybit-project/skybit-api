{
  "info": {
    "_postman_id": "0c74aa40-d7b3-4e3b-9fb8-c1ec7ecfd6e4",
    "name": "SkyBit API (v1)",
    "description": "SkyBit: Real-Time IoT Display and RGB Control System. Base URL defaults to production; override {{baseUrl}} for local development.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://skybit-api.mahros.dev/api/v1",
      "type": "string"
    },
    {
      "key": "adminApiKey",
      "value": "REPLACE_ME",
      "type": "string"
    },
    {
      "key": "deviceToken",
      "value": "REPLACE_ME",
      "type": "string"
    },
    {
      "key": "wsBaseUrl",
      "value": "wss://skybit-api.mahros.dev",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "SkyBit (v1)",
      "description": "REST endpoints for SkyBit state control. Auth: set {{adminApiKey}} and use x-api-key header for PATCH.",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks API availability and returns connected client counts + device heartbeat timestamp."
          }
        },
        {
          "name": "GET /state",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "state"
              ]
            },
            "description": "Returns the current LED + screen state."
          }
        },
        {
          "name": "PATCH /state (update LED + Screen)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"led\": { \"r\": 255, \"g\": 0, \"b\": 0, \"mode\": \"solid\" },\n  \"screen\": { \"text\": \"mahros\", \"mode\": \"scroll\", \"speedMs\": 30, \"size\": 2 }\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "state"
              ]
            },
            "description": "Updates the current state and broadcasts it to /api/v1/device/ws and /api/v1/frontend/ws."
          }
        },
        {
          "name": "PATCH /state (LED only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{adminApiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"led\": { \"r\": 10, \"g\": 20, \"b\": 30 }\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/state",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "state"
              ]
            },
            "description": "Partial update example."
          }
        },
        {
          "name": "WebSocket Notes (device + frontend)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Device WS: {{wsBaseUrl}}/api/v1/device/ws?token={{deviceToken}} (send {\"type\":\"heartbeat\"} periodically).\nFrontend WS: {{wsBaseUrl}}/api/v1/frontend/ws (receives {type:'state', payload:{...}} + {type:'deviceStatus', payload:{...}}).\n\nPostman collection format does not reliably encode WS requests across versions; use Postman's WebSocket tab with these URLs."
          }
        }
      ]
    }
  ]
}
