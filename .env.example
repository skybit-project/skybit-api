# Server
PORT=3030
NODE_ENV=development

# SkyBit auth
# Frontend uses this for PATCH /api/v1/state via header: x-api-key: <SKYBIT_ADMIN_API_KEY>
SKYBIT_ADMIN_API_KEY=change_me

# ESP8266 uses this to connect: ws(s)://<host>/api/v1/device/ws?token=<SKYBIT_DEVICE_TOKEN>
SKYBIT_DEVICE_TOKEN=change_me

# Make the API public (disables admin key + device token checks)
SKYBIT_PUBLIC_API=false

# CORS
# Set true to allow any Origin (use with care in production)
CORS_ALLOW_ALL=false

# Limits / validation
SKYBIT_MAX_SCREEN_TEXT_LEN=32
SKYBIT_JSON_BODY_LIMIT=10kb

# (Optional / existing in repo)
GEMINI_API_KEY=
